# Experimental S2 pilot: synthetic local values only, no vault resolvers.
# Remote environments intentionally fail validation until S4/S5 are approved.
# @defaultRequired=true
# @defaultSensitive=true
# @cache=disabled
# ---

# @type=enum(test) @public
APP_ENV=test

# Public local origin. No credentials, paths or non-loopback hosts.
# @type=url(allowedProtocols=[http], allowedDomains=[localhost, 127.0.0.1], matches=regex("^http://(localhost|127\\.0\\.0\\.1):[0-9]+$")) @public
BETTER_AUTH_URL=http://localhost:3000

# Publicly known synthetic fixture, NEVER a deployed authentication secret.
# @type=string(minLength=32, startsWith="test-only-") @sensitive
BETTER_AUTH_SECRET=test-only-fenod-fixture-auth-secret-not-for-deployment

# Reserved secret-zero name: never injected. No Doppler plugin is loaded in S2.
# @optional @sensitive @internal
DOPPLER_TOKEN=
