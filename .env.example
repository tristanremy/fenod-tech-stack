# ===========================================
# Fenod Stack Environment Variables
# ===========================================
# Prefer Infisical for real values:
#   infisical run --env=dev -- pnpm dev
# This file documents required keys only. Do not copy real secrets into git.
# If a tool requires dotenv, generate .env.local temporarily and delete it.

# -------------------------------------------
# Node Environment
# -------------------------------------------
NODE_ENV=development

# -------------------------------------------
# Better Auth
# -------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters

# Base URL for auth callbacks (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000

# -------------------------------------------
# OAuth Providers (optional)
# -------------------------------------------
# Google OAuth - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth - https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -------------------------------------------
# Cloudflare / Deploy Identity
# -------------------------------------------
# Store these in Infisical. CI should fetch them at runtime; local deploys should use:
#   infisical run --env=staging -- pnpm deploy:staging
# Account ID - found in Cloudflare dashboard URL
CLOUDFLARE_ACCOUNT_ID=

# API Token - create at https://dash.cloudflare.com/profile/api-tokens
# Required permissions depend on resources: Workers, D1, KV, R2, Queues, DNS as needed
CLOUDFLARE_API_TOKEN=

# D1 Database ID - from `wrangler d1 list`
CLOUDFLARE_D1_DATABASE_ID=

# -------------------------------------------
# Database (local development)
# -------------------------------------------
# For local SQLite (non-Cloudflare dev)
DATABASE_URL=file:./dev.db

# -------------------------------------------
# CORS
# -------------------------------------------
# Frontend URL for CORS (no trailing slash)
CORS_ORIGIN=http://localhost:3000

# -------------------------------------------
# Rate Limiting
# -------------------------------------------
# Redis URL for distributed rate limiting (optional)
# If not set, falls back to in-memory or database storage
REDIS_URL=

# -------------------------------------------
# Email (optional)
# -------------------------------------------
# Resend - https://resend.com/api-keys
RESEND_API_KEY=

# From address for transactional emails
EMAIL_FROM=noreply@yourdomain.com

# -------------------------------------------
# Observability (optional)
# -------------------------------------------
# Sentry DSN for error tracking
SENTRY_DSN=

# Analytics
ANALYTICS_ID=

# -------------------------------------------
# Alchemy / Stage
# -------------------------------------------
# Stage names should map to isolated Cloudflare resources.
STAGE=dev
ALCHEMY_PASSWORD=

# Feature Flags (optional)
# -------------------------------------------
# Enable features in development
ENABLE_DEBUG_MODE=true
ENABLE_MOCK_DATA=false
