{
  "name": "fenod-tech-stack",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "llms:build": "tsx scripts/generate-llms.ts",
    "check:context": "tsx scripts/generate-llms.ts --check",
    "check:llms": "tsx scripts/check-llms-defaults.ts",
    "check:enforcement": "tsx scripts/check-contract-enforcement.ts",
    "check": "pnpm check:context && pnpm check:llms && pnpm check:enforcement && pnpm test",
    "test": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.12"
  }
}
