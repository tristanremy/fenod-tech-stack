---
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="fenod-site-title" aria-label="Fenod Stack home">
  <img src="/favicon.svg" alt="" width="32" height="32" class="fenod-site-title__mark" />
  <span class="fenod-site-title__wordmark" translate="no">Fenod</span>
  <span class="fenod-site-title__badge" translate="no">stack</span>
</a>
