flowchart TB
  subgraph Platform[Cloudflare platform authority]
    DeployToken[Resource-scoped deploy token]
    D1Token[D1 migration token]
    DNSToken[Zone-scoped DNS token]
    ReadToken[Read-only logs / analytics token]
  end

  subgraph Provider[AI provider access]
    StoredKey[AI Gateway stored provider key]
    Budget[Gateway budget and rate limits]
    Route[Gateway route / fallback policy]
  end

  subgraph AgentBudget[Agent runtime budget]
    CodeMode[Code Mode / search-execute]
    Summaries[Summaries over raw tool output]
    Caps[Model spend caps]
  end

  Agent[AI agent] --> CodeMode
  Agent --> ReadToken
  Agent --> Broker[Broker / protected CI]
  Broker --> DeployToken
  Broker --> D1Token
  Broker --> DNSToken
  Worker[Worker app] --> Route
  Route --> StoredKey
  Route --> Budget
  CodeMode --> Summaries
  Summaries --> Caps
