flowchart TB
  subgraph Platform[Autorite plateforme Cloudflare]
    DeployToken[Token de deploiement scope ressource]
    D1Token[Token migrations D1]
    DNSToken[Token DNS scope zone]
    ReadToken[Token lecture logs / analytics]
  end
  subgraph Provider[Acces fournisseurs IA]
    StoredKey[Cle fournisseur stockee AI Gateway]
    Budget[Budgets et limites Gateway]
    Route[Route Gateway / politique de fallback]
  end
  subgraph AgentBudget[Budget runtime agent]
    CodeMode[Code Mode / search-execute]
    Summaries[Resumes plutot que sorties brutes]
    Caps[Plafonds de depense modele]
  end
  Agent[Agent IA] --> CodeMode
  Agent --> ReadToken
  Agent --> Broker[Broker / CI protegee]
  Broker --> DeployToken
  Broker --> D1Token
  Broker --> DNSToken
  Worker[Application Worker] --> Route
  Route --> StoredKey
  Route --> Budget
  CodeMode --> Summaries
  Summaries --> Caps
